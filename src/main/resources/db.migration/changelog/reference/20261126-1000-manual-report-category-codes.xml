<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Katalog hisobotlari (Form 12/13/28.1/28.2) final_icd10_code'ni qator kodlari
        bilan AYNAN solishtiradi. Seed qilingan to'plamlarda faqat kichik kodlar
        (A82.0, A82.1, ...) bor edi, shuning uchun uch belgili kod (A82) bilan
        tasdiqlangan holat hech bir qatorga tushmas edi.

        Uch belgili kod faqat qator butun kategoriyani anglatsa qo'shiladi va
        kategoriyaning barcha kichik kodlari qatorda allaqachon bo'lsa.
        Atayin qo'shilmagan:
          * kichik kodlari sanab yozilgan qatorlar (masalan 106, 136, 163);
          * 178/179 (B35 ikki qator orasida bo'lingan);
          * kategoriyasi to'liq bo'lmagan qatorlar: 141 (B18), 157 (J20, J21).

        Alohida bir martalik changeSet: 20260904-1000 seed'ini tahrirlasak
        (runOnChange) admin o'chirgan qatorlar qayta paydo bo'lib qolardi.
        Yozuvda shu kategoriyaning birorta kichik kodi qolmagan bo'lsa
        (admin qatorni o'zgartirgan), kod qo'shilmaydi.
    -->
    <changeSet id="20261126-1000-01-manual-report-category-codes" author="Tursunboyev Muhammadibrohim"
               runInTransaction="true">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <dbms type="postgresql"/>
            <tableExists tableName="ref_manual_report"/>
            <tableExists tableName="ref_manual_report_icd10_codes"/>
        </preConditions>

