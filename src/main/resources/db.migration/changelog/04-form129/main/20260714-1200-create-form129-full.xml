<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        logicalFilePath="db.migration/changelog/04-form129/main/20260714-1200-create-form129-full.xml"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Full schema for the form129 feature (laboratory reference certificate for
      syphilis/hepatitis B/brucellosis test results, sent from a lab/hospital/blood
      transfusion center to the Sanitary-Epidemiological Committee).

      Plain CRUD, no card/status workflow attached - only sender/receiver
      organization linkage plus the patient and 14 lab test result blocks.

      Every changeset is guarded by preConditions: if the corresponding
      table/index/constraint already exists, Liquibase simply marks it as ran
      (MARK_RAN) without error.
    -->

    <!-- ============================================================= -->
    <!-- form129 - main table                                           -->
    <!-- ============================================================= -->

    <changeSet author="uzinfocom" id="20260714-1200-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="form129"/>
            </not>
        </preConditions>
        <createTable tableName="form129">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="form129_pkey"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_id" type="BIGINT"/>
            <column name="created_org_uuid" type="UUID"/>
            <column name="updated_at" type="TIMESTAMP WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by_id" type="BIGINT"/>
            <column name="updated_org_uuid" type="UUID"/>
            <column name="uuid" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="med_record_id" type="VARCHAR(255)"/>
            <column name="patient_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sender_organization_id" type="BIGINT"/>
            <column name="receiver_organization_id" type="BIGINT"/>
            <column name="rw_result_code" type="VARCHAR(255)"/>
            <column name="rw_result_detail" type="VARCHAR(1000)"/>
            <column name="rpr_vdrl_result_code" type="VARCHAR(255)"/>
            <column name="rpr_vdrl_result_detail" type="VARCHAR(1000)"/>
            <column name="rpga_result_code" type="VARCHAR(255)"/>
            <column name="rpga_result_detail" type="VARCHAR(1000)"/>
            <column name="elisa_result_code" type="VARCHAR(255)"/>
            <column name="elisa_result_detail" type="VARCHAR(1000)"/>
            <column name="tpha_result_code" type="VARCHAR(255)"/>
            <column name="tpha_result_detail" type="VARCHAR(1000)"/>
            <column name="western_blot_result_code" type="VARCHAR(255)"/>
            <column name="western_blot_result_detail" type="VARCHAR(1000)"/>
            <column name="hbsag_result_code" type="VARCHAR(255)"/>
            <column name="hbsag_result_detail" type="VARCHAR(1000)"/>
            <column name="hbeag_result_code" type="VARCHAR(255)"/>
            <column name="hbeag_result_detail" type="VARCHAR(1000)"/>
            <column name="anti_hbc_igg_result_code" type="VARCHAR(255)"/>
            <column name="anti_hbc_igg_result_detail" type="VARCHAR(1000)"/>
            <column name="anti_hbc_igm_result_code" type="VARCHAR(255)"/>
            <column name="anti_hbc_igm_result_detail" type="VARCHAR(1000)"/>
            <column name="anti_hbe_result_code" type="VARCHAR(255)"/>
            <column name="anti_hbe_result_detail" type="VARCHAR(1000)"/>
            <column name="anti_hbs_result_code" type="VARCHAR(255)"/>
            <column name="anti_hbs_result_detail" type="VARCHAR(1000)"/>
            <column name="pcr_result_code" type="VARCHAR(255)"/>
            <column name="pcr_result_detail" type="VARCHAR(1000)"/>
            <column name="wright_heddelson_result_code" type="VARCHAR(255)"/>
            <column name="wright_heddelson_result_detail" type="VARCHAR(1000)"/>
            <column name="notifier_full_name" type="VARCHAR(255)"/>
            <column name="receiver_full_name" type="VARCHAR(255)"/>
            <column name="initial_report_date_time" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet author="uzinfocom" id="20260714-1200-2">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_form129_patient_id" tableName="form129"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_form129_patient_id" tableName="form129">
            <column name="patient_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="uzinfocom" id="20260714-1200-3">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_form129_sender_org_id" tableName="form129"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_form129_sender_org_id" tableName="form129">
            <column name="sender_organization_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="uzinfocom" id="20260714-1200-4">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_form129_receiver_org_id" tableName="form129"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_form129_receiver_org_id" tableName="form129">
            <column name="receiver_organization_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="uzinfocom" id="20260714-1200-5">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="idx_form129_created_at" tableName="form129"/>
            </not>
        </preConditions>
        <createIndex indexName="idx_form129_created_at" tableName="form129">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet author="uzinfocom" id="20260714-1200-6">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists tableName="form129" constraintName="uk_form129_uuid"/>
            </not>
        </preConditions>
        <addUniqueConstraint columnNames="uuid" constraintName="uk_form129_uuid" tableName="form129"/>
    </changeSet>

    <!-- ============================================================= -->
    <!-- Foreign keys                                                   -->
    <!-- ============================================================= -->

    <changeSet author="uzinfocom" id="20260714-1200-7">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_form129_patient" foreignKeyTableName="form129"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="patient_id" baseTableName="form129"
                                  constraintName="fk_form129_patient" onDelete="NO ACTION" onUpdate="NO ACTION"
                                  referencedColumnNames="id" referencedTableName="patient" validate="true"/>
    </changeSet>

    <changeSet author="uzinfocom" id="20260714-1200-8">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_form129_created_org" foreignKeyTableName="form129"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="created_org_uuid" baseTableName="form129"
                                  constraintName="fk_form129_created_org" onDelete="NO ACTION" onUpdate="NO ACTION"
                                  referencedColumnNames="uuid" referencedTableName="organization" validate="true"/>
    </changeSet>

    <changeSet author="uzinfocom" id="20260714-1200-9">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_form129_updated_org" foreignKeyTableName="form129"/>
            </not>
        </preConditions>
        <addForeignKeyConstraint baseColumnNames="updated_org_uuid" baseTableName="form129"
                                  constraintName="fk_form129_updated_org" onDelete="NO ACTION" onUpdate="NO ACTION"
                                  referencedColumnNames="uuid" referencedTableName="organization" validate="true"/>
    </changeSet>
</databaseChangeLog>
