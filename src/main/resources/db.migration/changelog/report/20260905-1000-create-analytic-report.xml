<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260905-1000-01-create-analytic-report" author="claude">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="rp_analytic_report"/>
            </not>
        </preConditions>
        <createTable tableName="rp_analytic_report">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_analytic_report" nullable="false"/>
            </column>
            <column name="version" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_id" type="BIGINT"/>
            <column name="updated_by_id" type="BIGINT"/>

            <column name="organization_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_analytic_report_organization_id"
                             references="organization(id)"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="FINAL">
                <constraints nullable="false"/>
            </column>
            <column name="from_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="to_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="koef" type="BIGINT" defaultValueNumeric="100000">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT"/>
        </createTable>

        <createIndex tableName="rp_analytic_report" indexName="idx_analytic_report_organization_id">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="rp_analytic_report" indexName="idx_analytic_report_from_to">
            <column name="from_date"/>
            <column name="to_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260905-1000-02-create-analytic-report-region-codes" author="claude">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="rp_analytic_report_region_codes"/>
            </not>
        </preConditions>
        <createTable tableName="rp_analytic_report_region_codes">
            <column name="analytic_report_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_analytic_report_region_codes_report_id"
                             references="rp_analytic_report(id)"/>
            </column>
            <column name="region_code" type="VARCHAR(20)"/>
        </createTable>
        <createIndex tableName="rp_analytic_report_region_codes" indexName="idx_analytic_report_region_codes_report_id">
            <column name="analytic_report_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260905-1000-03-create-analytic-report-icd10-codes" author="claude">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="rp_analytic_report_icd10_codes"/>
            </not>
        </preConditions>
        <createTable tableName="rp_analytic_report_icd10_codes">
            <column name="analytic_report_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_analytic_report_icd10_codes_report_id"
                             references="rp_analytic_report(id)"/>
            </column>
            <column name="icd10_code" type="VARCHAR(20)"/>
        </createTable>
        <createIndex tableName="rp_analytic_report_icd10_codes" indexName="idx_analytic_report_icd10_codes_report_id">
            <column name="analytic_report_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
