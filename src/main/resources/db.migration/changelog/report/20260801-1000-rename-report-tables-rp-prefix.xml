<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260801-1000-01-rename-form2-manual-entry-rp-prefix" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="form2_manual_entry"/>
                <not>
                    <tableExists tableName="rp_form2_manual_entry"/>
                </not>
            </and>
        </preConditions>
        <renameTable oldTableName="form2_manual_entry" newTableName="rp_form2_manual_entry"/>
    </changeSet>

