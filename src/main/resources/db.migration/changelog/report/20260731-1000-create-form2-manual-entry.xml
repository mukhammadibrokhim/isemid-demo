<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260731-1000-01-create-form2-manual-entry" author="codex">
        <createTable tableName="form2_manual_entry">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_form2_manual_entry" nullable="false"/>
            </column>
            <column name="version" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_id" type="BIGINT"/>
            <column name="updated_by_id" type="BIGINT"/>

            <column name="organization_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_form2_manual_entry_organization_id"
                             references="organization(id)"/>
            </column>
            <column name="from_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="to_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="registered_cases_last_year" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="registered_cases_current_year" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="mtm_school_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="disinfection_foci_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="inspected_objects_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="closed_objects_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ddu_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="school_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="fines_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="prosecutor_referral_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="form2_manual_entry" indexName="idx_form2_manual_entry_organization_id">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="form2_manual_entry" indexName="idx_form2_manual_entry_from_to">
            <column name="from_date"/>
            <column name="to_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
