<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260902-1000-01-create-rp-form7-entry" author="claude">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="rp_form7_entry"/>
            </not>
        </preConditions>
        <createTable tableName="rp_form7_entry">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_rp_form7_entry" nullable="false"/>
            </column>
            <column name="version" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_id" type="BIGINT"/>
            <column name="updated_by_id" type="BIGINT"/>

            <column name="organization_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_rp_form7_entry_organization_id"
                             references="organization(id)"/>
            </column>
            <column name="from_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="to_date" type="DATE">
                <constraints nullable="false"/>
            </column>

            <column name="cases_at_period_start" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <!-- Auto-computed snapshot (form058 + form058_1) -->
            <column name="registered_total" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="registered_under_14" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="registered_under_18" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="registered_adult" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="registered_female" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="registered_urban_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="registered_rural_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="examined_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="to_be_examined_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="primary_diagnosis_confirmed" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="hospitalized_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="cases_at_period_end" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="rp_form7_entry" indexName="idx_form7_entry_organization_id">
            <column name="organization_id"/>
        </createIndex>
        <createIndex tableName="rp_form7_entry" indexName="idx_form7_entry_from_to">
            <column name="from_date"/>
            <column name="to_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
