<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260801-1000-01-create-audit-event" author="codex">
        <createTable tableName="audit_event">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_audit_event" nullable="false"/>
            </column>
            <column name="version" type="BIGINT"/>

            <column name="event_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="old_status" type="VARCHAR(50)"/>
            <column name="new_status" type="VARCHAR(50)"/>
            <column name="old_org_id" type="BIGINT"/>
            <column name="new_org_id" type="BIGINT"/>
            <column name="actor_user_id" type="BIGINT"/>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- "History of this form/act" lookups -->
        <createIndex tableName="audit_event" indexName="idx_audit_event_entity">
            <column name="entity_type"/>
            <column name="entity_id"/>
            <column name="occurred_at"/>
        </createIndex>

        <!-- KPI: funnel/status-transition speed aggregation by event kind and time -->
        <createIndex tableName="audit_event" indexName="idx_audit_event_type_occurred">
            <column name="event_type"/>
            <column name="occurred_at"/>
        </createIndex>

        <!-- KPI: per-organization counts (reassignment volume, status changes received) -->
        <createIndex tableName="audit_event" indexName="idx_audit_event_new_org_occurred">
            <column name="new_org_id"/>
            <column name="occurred_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
