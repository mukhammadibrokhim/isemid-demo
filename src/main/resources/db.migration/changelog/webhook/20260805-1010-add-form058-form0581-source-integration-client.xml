<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Records the numeric IntegrationClient PK behind a form058/form058-1 submission,
        so the outbound webhook can look up whom to notify back once the record's status
        changes. Nullable - only populated for submissions made by a registered
        IntegrationClient (not SSO/DHP callers); onDelete=SET NULL so revoking/removing a
        client never blocks deleting the row itself.
    -->
    <changeSet id="20260805-1010-01-add-form058-source-integration-client" author="codex">
        <addColumn tableName="form058">
            <column name="source_integration_client_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="form058"
                baseColumnNames="source_integration_client_id"
                constraintName="fk_form058_source_integration_client"
                referencedTableName="integration_client"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
        <createIndex tableName="form058" indexName="idx_form058_source_integration_client_id">
            <column name="source_integration_client_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260805-1010-02-add-form0581-source-integration-client" author="codex">
        <addColumn tableName="form058_1">
            <column name="source_integration_client_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint
                baseTableName="form058_1"
                baseColumnNames="source_integration_client_id"
                constraintName="fk_form0581_source_integration_client"
                referencedTableName="integration_client"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
        <createIndex tableName="form058_1" indexName="idx_form0581_source_integration_client_id">
            <column name="source_integration_client_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
