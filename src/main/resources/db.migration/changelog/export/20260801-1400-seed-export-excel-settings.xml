    <!--
        Default column/style rows for the FORM058 and FORM0581 Excel exports (see
        ExcelExportSettingsResolver, Form058ExcelExportSource, Form0581ExcelExportSource) - not
        load-bearing (SystemSettingResolver already falls back to each source's own hardcoded
        defaults when a key is missing), but seeded here so the keys show up in
        /v1/admin/settings and /v1/dev/settings for someone to actually edit, instead of only
        existing as an undiscoverable convention in code.
    -->
    <changeSet id="20260801-1400-01-seed-export-excel-settings" author="codex">
        <insert tableName="system_settings">
            <column name="created_at" valueComputed="now()"/>
            <column name="updated_at" valueComputed="now()"/>
            <column name="version" valueNumeric="0"/>
            <column name="setting_key" value="export.excel.form058.columns"/>
            <column name="setting_value" value="id,notifyInfo,senderOrg,patientFio,age,address,workplace,diseaseDate,firstVisitDate,hospitalization,diagnosis,finalDiagnosis,epidemicInvestigation,notifiedOrg,labResult,note"/>
            <column name="value_type" value="STRING"/>
            <column name="description" value="Ordered, comma-separated column keys shown in the Form058 Excel export. Available keys: id, notifyInfo, senderOrg, patientFio, age, address, workplace, diseaseDate, firstVisitDate, hospitalization, diagnosis, finalDiagnosis, epidemicInvestigation, notifiedOrg, labResult, note."/>
            <column name="active" valueBoolean="true"/>
            <column name="deleted" valueBoolean="false"/>
        </insert>
