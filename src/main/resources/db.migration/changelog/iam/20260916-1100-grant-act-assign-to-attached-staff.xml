<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        20260825-1200-02 bo'yicha isemid_epidemiologist va
        isemid_assistant_epidemiologist ATTACH_ACT uchun faqat READ/UPDATE
        oladi (act'ni to'ldirish/LIS'ga yuborish - CardActCommandController
        PERMISSION_ATTACH_ACT_UPDATE, ActCommandController#sendToLis ham
        xuddi shu action'ga tayanadi), ASSIGN esa faqat isemid_epidim_head'da
        (kartaga/xodimlarga act biriktirish - CardActCommandController
        #assignActs -> PERMISSION_ATTACH_ACT_ASSIGN).

        Card bilan ishlaydigan xodimlar uchun act yaratish (ASSIGN),
        yuborish va tahrirlash (ikkalasi ham UPDATE) default ochiq bo'lishi
        so'ralgani sababli, bu yerda ASSIGN ham shu ikki rolga qo'shiladi.
        isemid_epidim_head'da allaqachon bor (o'zgarmaydi), isemid_admin /
        isemid_super_admin esa zzz-rbac-grants/20260828-1200 runAlways
        orqali ATTACH_ACT bo'yicha (deyarli) barcha action'ni allaqachon
        oladi - bu yerda tegilmaydi.
    -->
    <changeSet id="20260916-1100-01-grant-act-assign-to-attached-staff" author="uzinfocom">
        <preConditions onFail="HALT" onError="HALT">
            <dbms type="postgresql"/>
            <tableExists tableName="role_permissions"/>
            <tableExists tableName="role_permission_actions"/>
        </preConditions>

        <sql dbms="postgresql" splitStatements="true" stripComments="true"><![CDATA[
            INSERT INTO role_permission_actions (role_permission_id, action_id)
            SELECT rp.id, a.id
            FROM role_permissions rp
            JOIN role r ON r.id = rp.role_id
            JOIN permission p ON p.id = rp.permission_id
            JOIN action a ON a.code = 'ASSIGN'
            WHERE r.name IN ('isemid_epidemiologist', 'isemid_assistant_epidemiologist')
              AND p.subject = 'ATTACH_ACT'
            ON CONFLICT (role_permission_id, action_id) DO NOTHING;
        ]]></sql>
    </changeSet>

</databaseChangeLog>
