<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Kartalarni o'chirish (DELETE /cards/{id}) endi CARD DELETE talab qiladi. Kartalarni
        mudir biriktiradi (ASSIGN_CARDS), shuning uchun noto'g'ri biriktirilganini ham u
        o'chiradi: bo'lim mudiriga CARD DELETE beriladi. Holat qoidalari (faqat NEW /
        ACCEPTED_BY_USER / REJECTED_BY_USER) kodda o'zgarmaydi.
    -->
    <changeSet id="20261118-1110-01-grant-card-delete-to-head" author="uzinfocom">
        <preConditions onFail="HALT" onError="HALT">
            <dbms type="postgresql"/>
            <tableExists tableName="role_permissions"/>
            <tableExists tableName="role_permission_actions"/>
        </preConditions>

        <sql dbms="postgresql" splitStatements="true" stripComments="true"><![CDATA[
            INSERT INTO role_permission_actions (role_permission_id, action_id)
            SELECT rp.id, a.id
            FROM role_permissions rp
            JOIN role r ON r.id = rp.role_id
            JOIN permission p ON p.id = rp.permission_id
            JOIN action a ON upper(a.code) = 'DELETE'
            WHERE r.name = 'isemid_epidim_head'
              AND upper(p.subject) = 'CARD'
            ON CONFLICT (role_permission_id, action_id) DO NOTHING;
        ]]></sql>
    </changeSet>

</databaseChangeLog>
