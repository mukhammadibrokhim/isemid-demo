                 'Право утверждения/подтверждения.',
                 'Тасдиқлаш ҳуқуқи.',
                 'Tastıyıqlaw huqıqı.')
            ON CONFLICT (code) DO NOTHING;
        ]]></sql>
    </changeSet>

    <!--
        role_permission_actions: (role_permission_id, action varchar) ->
        (role_permission_id, action_id bigint FK -> action.id).
        Qadamlar: ustun qo'shish -> mavjud qatorlarni action.code orqali
        action_id bilan to'ldirish -> eski ustun/PK'ni olib tashlash ->
        yangi PK/FK/index qo'shish.
    -->
    <changeSet id="20260730-1100-03-add-action-id-column" author="codex">
        <preConditions onFail="HALT" onError="HALT">
            <dbms type="postgresql"/>
            <tableExists tableName="role_permission_actions"/>
            <columnExists tableName="role_permission_actions" columnName="action"/>
            <not>
                <columnExists tableName="role_permission_actions" columnName="action_id"/>
            </not>
        </preConditions>

        <addColumn tableName="role_permission_actions">
            <column name="action_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260730-1100-04-backfill-action-id" author="codex">
        <preConditions onFail="HALT" onError="HALT">
            <dbms type="postgresql"/>
            <columnExists tableName="role_permission_actions" columnName="action_id"/>
            <columnExists tableName="role_permission_actions" columnName="action"/>
        </preConditions>

        <sql dbms="postgresql" splitStatements="true" stripComments="true"><![CDATA[
            UPDATE role_permission_actions rpa
            SET action_id = a.id
            FROM action a
            WHERE a.code = rpa.action
              AND rpa.action_id IS NULL;
        ]]></sql>
    </changeSet>

    <changeSet id="20260730-1100-05-finalize-role-permission-actions-schema" author="codex">
        <preConditions onFail="HALT" onError="HALT">
            <dbms type="postgresql"/>
            <columnExists tableName="role_permission_actions" columnName="action_id"/>
            <columnExists tableName="role_permission_actions" columnName="action"/>
        </preConditions>

        <addNotNullConstraint tableName="role_permission_actions" columnName="action_id" columnDataType="BIGINT"/>

        <dropPrimaryKey tableName="role_permission_actions" constraintName="role_permission_actions_pkey"/>

        <dropColumn tableName="role_permission_actions" columnName="action"/>

        <addPrimaryKey tableName="role_permission_actions"
                        columnNames="role_permission_id, action_id"
                        constraintName="role_permission_actions_pkey"/>

        <addForeignKeyConstraint baseTableName="role_permission_actions"
                                  baseColumnNames="action_id"
                                  constraintName="fk_role_permission_actions_action_id"
                                  referencedTableName="action"
                                  referencedColumnNames="id"
                                  onDelete="NO ACTION"
                                  onUpdate="NO ACTION"/>

        <createIndex indexName="idx_role_permission_actions_action_id" tableName="role_permission_actions" using="btree">
            <column name="action_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
