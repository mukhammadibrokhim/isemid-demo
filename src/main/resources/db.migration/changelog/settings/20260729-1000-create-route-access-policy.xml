    <changeSet id="20260729-1000-01-create-route-access-policy" author="codex">
        <createTable tableName="security_route_policy">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_security_route_policy" nullable="false"/>
            </column>
            <column name="version" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_id" type="BIGINT"/>
            <column name="updated_by_id" type="BIGINT"/>

            <column name="pattern" type="VARCHAR(200)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_security_route_policy_pattern"/>
            </column>
            <column name="display_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="open" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="organization_header_required" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="role_validation_required" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
        </createTable>

        <createIndex tableName="security_route_policy" indexName="idx_security_route_policy_enabled_order">
            <column name="enabled"/>
            <column name="display_order"/>
        </createIndex>
    </changeSet>

