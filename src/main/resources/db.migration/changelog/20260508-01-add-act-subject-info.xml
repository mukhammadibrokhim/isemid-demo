<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- If old column subject_inn exists, rename it to subject_tin -->
    <changeSet id="2026-05-08-02-rename-subject-inn-to-subject-tin" author="muhammadibrohim">
        <preConditions onFail="MARK_RAN">
            <and>
                <columnExists tableName="act" columnName="subject_inn"/>
                <not>
                    <columnExists tableName="act" columnName="subject_tin"/>
                </not>
            </and>
        </preConditions>

        <renameColumn
                tableName="act"
                oldColumnName="subject_inn"
                newColumnName="subject_tin"
                columnDataType="varchar(20)"/>
    </changeSet>

    <changeSet id="2026-05-08-03-add-act-subject-type-code" author="muhammadibrohim">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="act" columnName="subject_type_code"/>
            </not>
        </preConditions>

        <addColumn tableName="act">
            <column name="subject_type_code" type="varchar(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-05-08-04-add-act-subject-tin" author="muhammadibrohim">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="act" columnName="subject_tin"/>
            </not>
        </preConditions>

        <addColumn tableName="act">
            <column name="subject_tin" type="varchar(20)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-05-08-05-add-act-subject-legal-name" author="muhammadibrohim">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="act" columnName="subject_legal_name"/>
            </not>
        </preConditions>

        <addColumn tableName="act">
            <column name="subject_legal_name" type="varchar(500)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-05-08-06-add-act-subject-legal-address" author="muhammadibrohim">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="act" columnName="subject_legal_address"/>
            </not>
        </preConditions>

        <addColumn tableName="act">
            <column name="subject_legal_address" type="varchar(1000)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-05-08-07-add-act-subject-actual-address" author="muhammadibrohim">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="act" columnName="subject_actual_address"/>
            </not>
        </preConditions>

        <addColumn tableName="act">
            <column name="subject_actual_address" type="varchar(1000)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-05-08-08-add-act-subject-type-code-index" author="muhammadibrohim">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="act" indexName="idx_act_subject_type_code"/>
            </not>
        </preConditions>

        <createIndex tableName="act" indexName="idx_act_subject_type_code">
            <column name="subject_type_code"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-05-08-09-add-act-subject-tin-index" author="muhammadibrohim">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="act" indexName="idx_act_subject_tin"/>
            </not>
        </preConditions>

        <createIndex tableName="act" indexName="idx_act_subject_tin">
            <column name="subject_tin"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>