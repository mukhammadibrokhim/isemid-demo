<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        The printed form058 ("Xabar yuboruvchining imzosi" / notifier
        signature) already resolves automatically from created_by. The
        receiver's signature ("Sanepidstantsiyada xabarni qabul
        qiluvchining imzosi") had no dedicated field - it was proxied off
        whoever later attached a card, which is null until a card exists.
        These columns record who actually called accept() and when, so the
        receiver signature can be resolved the same way the notifier one
        already is.
    -->
    <changeSet id="20260918-1000-01-add-form058-accept-info" author="claude">
        <addColumn tableName="form058">
            <column name="accepted_by_id" type="BIGINT"/>
            <column name="accepted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
