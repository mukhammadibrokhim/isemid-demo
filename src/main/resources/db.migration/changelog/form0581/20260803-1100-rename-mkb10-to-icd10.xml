    <changeSet id="20260803-1100-04-rename-form0581-final-mkb10-name" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <columnExists tableName="form058_1" columnName="final_mkb10_name"/>
        </preConditions>
        <renameColumn tableName="form058_1" oldColumnName="final_mkb10_name" newColumnName="final_icd10_name" columnDataType="VARCHAR(512)"/>
    </changeSet>

    <changeSet id="20260803-1100-05-rename-idx-form0581-mkb10-code" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <indexExists tableName="form058_1" indexName="idx_form0581_mkb10_code"/>
        </preConditions>
        <sql dbms="postgresql">ALTER INDEX idx_form0581_mkb10_code RENAME TO idx_form0581_icd10_code;</sql>
    </changeSet>
