    </changeSet>
    <changeSet id="20260803-1100-07-rename-idx-form0581-sender-mkb10" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <indexExists tableName="form058_1" indexName="idx_form0581_sender_mkb10"/>
        </preConditions>
        <sql dbms="postgresql">ALTER INDEX idx_form0581_sender_mkb10 RENAME TO idx_form0581_sender_icd10;</sql>
    </changeSet>
    <changeSet id="20260803-1100-08-rename-idx-form0581-mkb10-not-deleted" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <indexExists tableName="form058_1" indexName="idx_form0581_mkb10_not_deleted"/>
        </preConditions>
        <sql dbms="postgresql">ALTER INDEX idx_form0581_mkb10_not_deleted RENAME TO idx_form0581_icd10_not_deleted;</sql>
