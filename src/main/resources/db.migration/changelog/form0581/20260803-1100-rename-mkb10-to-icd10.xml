<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Table is physically named form058_1, not form0581. -->

    <changeSet id="20260803-1100-01-rename-form0581-mkb10-code" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <columnExists tableName="form058_1" columnName="mkb10_code"/>
        </preConditions>
        <renameColumn tableName="form058_1" oldColumnName="mkb10_code" newColumnName="icd10_code" columnDataType="VARCHAR(20)"/>
    </changeSet>
    <changeSet id="20260803-1100-02-rename-form0581-mkb10-name" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <columnExists tableName="form058_1" columnName="mkb10_name"/>
        </preConditions>
        <renameColumn tableName="form058_1" oldColumnName="mkb10_name" newColumnName="icd10_name" columnDataType="VARCHAR(512)"/>
    </changeSet>
    <changeSet id="20260803-1100-03-rename-form0581-final-mkb10-code" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <columnExists tableName="form058_1" columnName="final_mkb10_code"/>
        </preConditions>
        <renameColumn tableName="form058_1" oldColumnName="final_mkb10_code" newColumnName="final_icd10_code" columnDataType="VARCHAR(20)"/>
