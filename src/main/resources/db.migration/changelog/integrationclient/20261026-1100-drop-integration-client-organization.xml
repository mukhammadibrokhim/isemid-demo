<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        The per-client allowed-organizations list is gone: an EXTERNAL_TOKEN client may
        name any organization of its provider, every other client keeps only its default
        organization.
    -->
    <changeSet id="20261026-1100-01-drop-integration-client-organization" author="codex">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="integration_client_organization"/>
        </preConditions>
        <dropTable tableName="integration_client_organization"/>
    </changeSet>
</databaseChangeLog>
