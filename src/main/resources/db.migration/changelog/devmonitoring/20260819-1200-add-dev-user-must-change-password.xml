<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Forces a password change on next login for every dev-panel account,
        including the bootstrap "dev-admin" SUPER_ADMIN seeded by
        20260729-1200-seed-dev-admin-user.xml with a known, in-source-control
        password - the exact account that migration's own SECURITY NOTE warned
        should be rotated. defaultValueBoolean="true" backfills every existing
        row, not just future inserts (same pattern as
        20260804-1000-add-dev-user-root-flag.xml). Enforced by
        DevPasswordChangeGuardFilter, which blocks every /v1/dev/** request
        from an account with this flag set except its own
        PATCH /v1/dev/dev-users/me/password call. New accounts default to
        true too (see DevUser.mustChangePassword) and DevUserCommandService.
        changeOwnPassword clears it once the account's real owner sets their
        own password.
    -->
    <changeSet id="20260819-1200-01-add-dev-user-must-change-password" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="dev_user"/>
            <not>
                <columnExists tableName="dev_user" columnName="must_change_password"/>
            </not>
        </preConditions>

        <addColumn tableName="dev_user">
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
