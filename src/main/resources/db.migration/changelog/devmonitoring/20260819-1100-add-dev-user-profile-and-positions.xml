<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Dev-panel-only lookup ("spravochnik") of positions/departments,
        assignable to a DevUser's profile - separate from the org-facing,
        multi-language modules.reference dictionaries (see DevPosition,
        DevPositionController, /v1/dev/ref/positions).
    -->
    <changeSet id="20260819-1100-01-create-dev-position" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="dev_position"/>
            </not>
        </preConditions>

        <createTable tableName="dev_position">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_dev_position" nullable="false"/>
            </column>
            <column name="version" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_id" type="BIGINT"/>
            <column name="updated_by_id" type="BIGINT"/>

            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_dev_position_name"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!--
        Profile detail for DevUser - contact info + optional position/department,
        purely descriptive (never used for auth or notifications). Nullable:
        existing accounts (including the seeded "dev-admin" bootstrap account)
        predate these fields.
    -->
    <changeSet id="20260819-1100-02-add-dev-user-profile-columns" author="codex">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <tableExists tableName="dev_user"/>
            <not>
                <columnExists tableName="dev_user" columnName="email"/>
            </not>
        </preConditions>

        <addColumn tableName="dev_user">
            <column name="email" type="VARCHAR(150)"/>
            <column name="full_name" type="VARCHAR(200)"/>
            <column name="phone" type="VARCHAR(32)"/>
            <column name="position_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="dev_user"
                baseColumnNames="position_id"
                constraintName="fk_dev_user_position"
                referencedTableName="dev_position"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
