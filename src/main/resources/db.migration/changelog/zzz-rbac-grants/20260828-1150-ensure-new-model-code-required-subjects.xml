<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Yangi nomlash modelida (docs/permission-naming-mapping.md) kod @PreAuthorize bilan
        tekshiradigan subject va action'lar (platform.security.auth.Permissions) har startda
        faol va o'chirilmagan holatda bo'lishi kerak: ularsiz authority hosil bo'lmaydi va
        hamma foydalanuvchi jim 403 oladi (REPORTS bilan shunday bo'lgan - 01a changeSet).

        Fayl nomi ataylab 20260828-1200-sync-super-admin-full-access.xml'dan OLDIN tartiblanadi
        (includeAll yo'l bo'yicha alifbo tartibida yuritadi): bu yerda qayta faollashtirilgan
        qatorlarni o'sha fayldagi runAlways sinxronlash shu yugurishdayoq super_admin/admin'ga
        beradi. Qatorlarning o'zi iam/20261118-1000-permission-model-expand.xml da yaratiladi;
        bu changeSet faqat yangilaydi (qator yo'q bo'lsa hech narsa qilmaydi).
    -->
    <changeSet id="20261118-1150-01-ensure-new-model-code-required-subjects" author="uzinfocom" runAlways="true">
        <preConditions onFail="CONTINUE" onError="CONTINUE">
            <dbms type="postgresql"/>
            <tableExists tableName="permission"/>
            <tableExists tableName="action"/>
        </preConditions>

        <sql dbms="postgresql" splitStatements="true" stripComments="true"><![CDATA[
            UPDATE permission
            SET active = true, deleted = false, deleted_at = NULL, updated_at = CURRENT_TIMESTAMP
            WHERE subject IN ('REPORT', 'REPORT_ENTRY', 'ANALYTIC_REPORT', 'ACT', 'CARD', 'SPEECH_TO_TEXT')
              AND (active = false OR deleted = true OR deleted_at IS NOT NULL);

            UPDATE action
            SET active = true, deleted = false, deleted_at = NULL, updated_at = CURRENT_TIMESTAMP
            WHERE code IN ('READ', 'CREATE', 'UPDATE', 'DELETE', 'EXPORT', 'ASSIGN', 'VIEW_ALL')
              AND (active = false OR deleted = true OR deleted_at IS NOT NULL);
        ]]></sql>
    </changeSet>

</databaseChangeLog>
