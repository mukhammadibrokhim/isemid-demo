<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260803-1100-01-create-notification" author="codex">
        <createTable tableName="notification">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_notification" nullable="false"/>
            </column>
            <column name="version" type="BIGINT"/>

            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="recipient_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="organization_id" type="BIGINT"/>
            <column name="message_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="message_params" type="VARCHAR(2000)"/>
            <column name="read" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="read_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="occurred_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- "My notifications, newest first / unread only" — the controller's main read path -->
        <createIndex tableName="notification" indexName="idx_notification_recipient_read_occurred">
            <column name="recipient_user_id"/>
            <column name="read"/>
            <column name="occurred_at"/>
        </createIndex>

        <!-- Lookups by the entity a notification is about -->
        <createIndex tableName="notification" indexName="idx_notification_entity">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
