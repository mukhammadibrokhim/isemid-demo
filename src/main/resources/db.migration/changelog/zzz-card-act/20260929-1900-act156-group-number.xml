<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        «Guruh raqami» (act156 group row): the legacy form bound this box to the
        row's own id, so it was never stored. Now a column of its own, free text
        (groups are often named like "5-A"). Existing rows stay NULL.
    -->
    <changeSet id="20260929-1900-01-act156-group-number" author="uzinfocom">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="act156_group_detail" columnName="group_number"/>
            </not>
        </preConditions>
        <addColumn tableName="act156_group_detail">
            <column name="group_number" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
