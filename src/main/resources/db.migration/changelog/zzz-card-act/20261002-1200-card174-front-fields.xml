<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        `animal_type` comes back as the card's own ANIMAL_TYPE catalog code:
        20261002-1100 moved the old column into the laboratory table's
        `sample_name`, but the animal type is a separate field of the card.
    -->
    <changeSet id="20261002-1200-01-card174-animal-type" author="uzinfocom">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="card174" columnName="animal_type"/>
            </not>
        </preConditions>
        <addColumn tableName="card174">
            <column name="animal_type" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20261002-1200-02-card174-owner-pinfl" author="uzinfocom">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="card174" columnName="owner_pinfl"/>
            </not>
        </preConditions>
        <addColumn tableName="card174">
            <column name="owner_pinfl" type="VARCHAR(14)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20261002-1200-03-card174-infection-monitoring-pinfl-contact-date" author="uzinfocom">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <columnExists tableName="card174_infection_monitoring" columnName="pinfl"/>
            </not>
        </preConditions>
        <addColumn tableName="card174_infection_monitoring">
            <column name="pinfl" type="VARCHAR(14)"/>
            <column name="contact_infection_date" type="date"/>
        </addColumn>
    </changeSet>

    <changeSet id="20261002-1200-04-create-card174-animal-measure" author="uzinfocom">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="card174_animal_measure"/>
            </not>
        </preConditions>
        <createTable tableName="card174_animal_measure">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="card174_animal_measure_pkey"/>
            </column>
            <column name="version" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_id" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by_id" type="BIGINT"/>
            <column name="uuid" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="measure_name" type="VARCHAR(500)"/>
            <column name="measure_date" type="date"/>
            <column name="measure_count" type="INTEGER"/>
            <column name="measure_location" type="VARCHAR(500)"/>
            <column name="card174_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_card174_animal_measure_card174_id" tableName="card174_animal_measure">
            <column name="card174_id"/>
        </createIndex>
        <addUniqueConstraint columnNames="uuid" constraintName="uk_card174_animal_measure_uuid"
                             tableName="card174_animal_measure"/>
        <addForeignKeyConstraint baseColumnNames="card174_id" baseTableName="card174_animal_measure"
                                 constraintName="fk_card174_animal_measure_card174"
                                 referencedColumnNames="id" referencedTableName="card174"/>
    </changeSet>

</databaseChangeLog>
