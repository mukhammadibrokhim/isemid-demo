<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        IDENTITY sequence'larni max(id) ga sinxronlash (har yugurishда).

        Muammo: jadval id ustunlari Liquibase `autoIncrement` -> PostgreSQL'da
        `GENERATED BY DEFAULT AS IDENTITY`. Agar qatorlar EXPLICIT id bilan
        kiritilsa (legacy `public` -> `public2` ko'chirish, `pg_dump` restore,
        qo'lda seed, boshqa DB'dan import) identity sequence O'ZI SURILMAYDI.
        Natijada ilova birinchi INSERT'da:
            duplicate key value violates unique constraint "<jadval>_pkey"
            Key (id)=(N) already exists
        (kuzatilgan: `pt_address_pkey`, keyin form-058 zanjiridagi boshqa
        jadvallar — patient / pt_affiliation / pt_identifier / fm058_location).

        Yechim: bu changeset `runAlways="true"` — har Liquibase update'da
        (deploy/restart) BAZADAGI HAR BIR user schema'ning HAR BIR jadvalidagi
        HAR BIR identity/serial ustun sequence'ini `GREATEST(max(id), 1)` ga
        suradi. `id` ga qattiq bog'lanmagan; keyinroq qo'shilgan jadvallar ham
        avtomatik kiradi. Jadval bo'sh bo'lsa `is_called=false` (keyingi
        nextval = 1), aks holda `is_called=true` (keyingi = max+1).

        Xavfsiz: hech qanday qator o'zgartirmaydi/o'chirmaydi, faqat `setval`.
        Idempotent — ketma-ket yugurishlar bir xil natija beradi. Sequence
        allaqachon oldinda bo'lsa (odatiy holat) `GREATEST` uni pasaytirmaydi.

        NIMA UCHUN "zzz-sequences/" papkasida: Liquibase <includeAll>
        fayllarni to'liq yo'l bo'yicha alifbo tartibida ishga tushiradi
        (papka nomi sana prefiksidan ustun). Bu papka barcha modul
        papkalaridan — jumladan `zzz-card-act/` va `zzz-rbac-grants/` dan —
        KEYIN turadi, shu sababli bu changeset har yugurishda ENG OXIRIDA,
        barcha jadvallar yaratilгандан keyin ishlaydi.

        Bu Liquibase changeset MANUAL bulk-load'ni O'RNINI BOSMAYDI: legacy
        ko'chirish `psql` orqali ilovadан TASHQARIDA bo'ladi. Ko'chirishдан
        keyin ilovani QAYTA ISHGA TUSHIRISH kifoya — shu changeset
        sequence'larni to'g'rilaydi. (Yoki ilovani to'xtatmasдан:
        `db/legacy-migration/95-fix-sequences.sql`.)
    -->

    <changeSet id="20260904-1200-01-resync-identity-sequences" author="uzinfocom" runAlways="true">
        <preConditions onFail="CONTINUE" onError="CONTINUE">
            <dbms type="postgresql"/>
        </preConditions>

        <sql dbms="postgresql" splitStatements="false" stripComments="true"><![CDATA[
            DO $$
            DECLARE
              r     record;
              v_seq text;
              v_max bigint;
            BEGIN
              -- HAR BIR user schema'даги (pg_catalog / information_schema /
              -- pg_toast / pg_temp* dan tashqari) HAR BIR jadvalning HAR BIR
              -- identity/serial ustuni. `id` ga bog'lanmagan — bir nechта
              -- identity ustun bo'lsa ham hammasi qamrab olinadi. Yangi
              -- jadvallar keyinroq qo'shilsa ham runAlways tufayli avtomatik
              -- kiradi. Bo'sh jadval -> is_called=false (keyingi nextval=1).
              FOR r IN
                SELECT n.nspname AS sch, c.relname AS tbl, a.attname AS col,
                       pg_get_serial_sequence(format('%I.%I', n.nspname, c.relname), a.attname) AS seq
                FROM pg_class     c
                JOIN pg_namespace n ON n.oid = c.relnamespace
                JOIN pg_attribute a ON a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped
                WHERE c.relkind = 'r'
                  AND n.nspname NOT IN ('pg_catalog', 'information_schema')
                  AND n.nspname NOT LIKE 'pg_toast%'
                  AND n.nspname NOT LIKE 'pg_temp%'
                  AND pg_get_serial_sequence(format('%I.%I', n.nspname, c.relname), a.attname) IS NOT NULL
              LOOP
                v_seq := r.seq;
                EXECUTE format('SELECT COALESCE(max(%I), 0) FROM %I.%I', r.col, r.sch, r.tbl) INTO v_max;
                PERFORM setval(v_seq, GREATEST(v_max, 1), v_max > 0);
              END LOOP;
            END $$;
        ]]></sql>
    </changeSet>

</databaseChangeLog>
