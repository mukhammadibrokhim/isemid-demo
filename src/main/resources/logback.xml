<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false">

    <!-- =========================================================
         Spring Properties
         This file must be named logback-spring.xml.
         ========================================================= -->
    <springProperty scope="context"
                    name="APP_NAME"
                    source="spring.application.name"
                    defaultValue="isemid"/>

    <springProperty scope="context"
                    name="APP_PROFILE"
                    source="spring.profiles.active"
                    defaultValue="default"/>

    <!--
        Default local log directory: logs
        For production, override it using an environment variable:
        LOGS_HOME=/var/log/isemid
    -->
    <property name="LOGS_HOME" value="${LOGS_HOME:-logs}"/>


    <!-- =========================================================
         Log Patterns
         ========================================================= -->
    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS,Asia/Tashkent} [%thread] %-5level app=${APP_NAME} profile=${APP_PROFILE} traceId=%X{traceId:-N/A} spanId=%X{spanId:-N/A} userId=%X{userId:-N/A} orgId=%X{organizationId:-N/A} %logger{40} - %msg%n%ex{full}"/>

    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS,Asia/Tashkent} [%thread] %-5level app=${APP_NAME} profile=${APP_PROFILE} traceId=%X{traceId:-N/A} spanId=%X{spanId:-N/A} userId=%X{userId:-N/A} orgId=%X{organizationId:-N/A} %logger{70} - %msg%n%ex{full}"/>

    <property name="AUDIT_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS,Asia/Tashkent};app=${APP_NAME};profile=${APP_PROFILE};traceId=%X{traceId:-N/A};spanId=%X{spanId:-N/A};userId=%X{userId:-N/A};orgId=%X{organizationId:-N/A};%msg%n"/>


    <!-- =========================================================
         Console Appender
         ========================================================= -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>


    <!-- =========================================================
         Application File Appender
         ========================================================= -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_HOME}/${APP_NAME}-app.log</file>
        <append>true</append>
        <prudent>false</prudent>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_HOME}/${APP_NAME}-app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>


    <!-- =========================================================
         Async Application File Appender
         Prevents request threads from blocking directly on disk I/O.
         ========================================================= -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="FILE"/>
    </appender>


    <!-- =========================================================
         Audit File Appender
         Audit events are stored separately from application logs.
         ========================================================= -->
    <appender name="FILE_AUDIT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS_HOME}/${APP_NAME}-audit.log</file>
        <append>true</append>
        <prudent>false</prudent>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS_HOME}/${APP_NAME}-audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${AUDIT_PATTERN}</pattern>
        </encoder>
    </appender>


    <!-- =========================================================
         Graylog Appender
         =========================================================

         IMPORTANT:
         Graylog host, port, URL, facility, and additional fields must remain unchanged.

         If your project already has a Graylog appender, paste the existing block here
         without changing its host, port, URL, facility, encoder, or custom fields.

         Example:
         <appender name="GRAYLOG" class="...">
             ...
         </appender>
    -->


    <!--
        Enable this wrapper only if your existing Graylog appender name is GRAYLOG.

        This does not change the Graylog host, port, or URL.
        It only sends logs asynchronously.
    -->
    <!--
    <appender name="ASYNC_GRAYLOG" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="GRAYLOG"/>
    </appender>
    -->


    <!-- =========================================================
         Framework Loggers
         ========================================================= -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.web" level="WARN"/>
    <logger name="org.springframework.security" level="WARN"/>

    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql" level="WARN"/>

    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="liquibase" level="INFO"/>


    <!-- =========================================================
         Application Loggers
         ========================================================= -->
    <logger name="uz.uzinfocom.isemid" level="INFO"/>
    <logger name="uz.uzinfocom.hepatitis" level="INFO"/>


    <!-- =========================================================
         Audit Logger
         Usage in code:
         LoggerFactory.getLogger("audit-log")
         ========================================================= -->
    <logger name="audit-log" level="INFO" additivity="false">
        <appender-ref ref="FILE_AUDIT"/>

        <!-- Enable this only if audit events must also be sent to Graylog. -->
        <!-- <appender-ref ref="ASYNC_GRAYLOG"/> -->
    </logger>


    <!-- =========================================================
         Development / Test / Default Profiles
         ========================================================= -->
    <springProfile name="dev,test,default">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="ASYNC_FILE"/>

            <!-- Enable this only if Graylog must be used in dev/test environments. -->
            <!-- <appender-ref ref="ASYNC_GRAYLOG"/> -->
        </root>
    </springProfile>


    <!-- =========================================================
         Production Profile
         ========================================================= -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="ASYNC_FILE"/>

            <!-- Enable this if your existing Graylog appender is configured. -->
            <!-- <appender-ref ref="ASYNC_GRAYLOG"/> -->
        </root>
    </springProfile>

</configuration>