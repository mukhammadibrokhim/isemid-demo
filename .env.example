# Local dev environment overrides, loaded automatically on startup via
# springboot4-dotenv (see pom.xml). Copy this file to .env and edit as
# needed - .env itself is gitignored and must never be committed.
#
# Every variable below already has a fallback default in
# application-dev.properties, so .env is optional for a stock local setup;
# use it to override anything without exporting shell env vars by hand.
# A real process env var of the same name always wins over the value here,
# so leaving a .env in place is harmless even outside local dev.
# For a prod deployment, use .env.prod.example instead - prod has no
# built-in fallbacks for most of these and needs real values supplied.

SPRING_PROFILES_ACTIVE=dev

# =========================
# Server / async / dev tooling
# =========================
SERVER_PORT=8081
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5
ASYNC_CORE_POOL_SIZE=8
ASYNC_MAX_POOL_SIZE=32
ASYNC_QUEUE_CAPACITY=2000
DEV_METRICS_STREAM_INTERVAL_MS=3000
DOCS_DIR=docs

# =========================
# Database
# =========================
DB_URL=jdbc:postgresql://localhost:5434/isemid2
DB_USERNAME=postgres
DB_PASSWORD=root123

# =========================
# CORS
# =========================
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ykem.sanepid.uz,https://test-ykem.sanepid.uz

# =========================
