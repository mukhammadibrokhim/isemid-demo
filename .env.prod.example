# Prod environment template, loaded automatically on startup via
# springboot4-dotenv (see pom.xml) if a file named .env exists in the
# process's working directory - copy this to .env there (or set
# SPRINGDOTENV_DIRECTORY to point at wherever it's mounted) and fill in
# the REQUIRED values. A real OS/container/orchestrator env var of the
# same name always overrides whatever is in .env, so this file is safe to
# use alongside a secret manager - it only fills whatever isn't already
# set. Never commit the filled-in .env - only this template.
#
# Mirrors application.properties + application-prod.properties. Unlike
# the dev profile, most auth/integration values below have NO built-in
# fallback in prod and the app will fail to start (or run misconfigured)
# without them.

SPRING_PROFILES_ACTIVE=prod

# =========================
# REQUIRED - no fallback in prod
# =========================
DB_URL=jdbc:postgresql://<host>:<port>/<database>
DB_USERNAME=
DB_PASSWORD=
# Comma-separated list of frontend origins allowed to call this API from a
# browser. Left empty, no cross-origin request is allowed at all (safe
# default, but the SPA won't work until this is set).
APP_CORS_ALLOWED_ORIGINS=
# Outbound status-change webhook payload signing key (see platform.webhook).
WEBHOOK_SECRET_KEY=
# Real prod client_id for SSO's public-SPA authorization_code+PKCE client -
# only the dev/test client is pre-filled in application-dev.properties.
SSO_WEB_LOGIN_CLIENT_ID=

# =========================
# OPTIONAL - already has a working prod default, override only if needed
# =========================
#SERVER_PORT=8081
#APP_BASE_URI=https://ykem.sanepid.uz
#DB_POOL_MAX=20
#DB_POOL_MIN_IDLE=5
#ASYNC_CORE_POOL_SIZE=8
#ASYNC_MAX_POOL_SIZE=32
#ASYNC_QUEUE_CAPACITY=2000
#DOCS_DIR=docs
#EXPORT_STORAGE_DIR=exports
#EXPORT_MAX_ROWS=200000
#EXPORT_RETENTION_DAYS=7
#EXPORT_CLEANUP_CRON=0 0 3 * * *
#WEBHOOK_CONNECT_TIMEOUT=3s
#WEBHOOK_READ_TIMEOUT=10s
#WEBHOOK_DISPATCH_POLL_INTERVAL_MS=15000
#SSO_AUTH_BASE_DOMAIN=https://sso.ssv.uz
#SSO_IAM_API_BASE_DOMAIN=https://api2.ssv.uz
#SSO_ISSUER_URI=
#SSO_PUBLIC_KEY_URI=
#SSO_ORGANIZATION_URL_TEMPLATE=
#SSO_PRACTITIONER_URL_TEMPLATE=
#SSO_WEB_LOGIN_TOKEN_URL=https://sso.ssv.uz/oauth/token
#DHP_AUTH_BASE_DOMAIN=https://sso.dhp.uz
#DHP_FHIR_BASE_DOMAIN=https://fhir.dhp.uz
#DHP_ISSUER_URI=
#DHP_JWKS_URI=
#DHP_ORGANIZATION_URL_TEMPLATE=
#DHP_PRACTITIONER_URL_TEMPLATE=

# =========================
# DHP login (dhp-web) - only relevant if app.auth.login.providers.dhp-web.enabled
# is flipped to true in application-prod.properties (currently hardcoded false,
# not env-driven); real client_id/secret/token-url are not yet confirmed for prod.
# =========================
#DHP_WEB_LOGIN_TOKEN_URL=
#DHP_WEB_LOGIN_CLIENT_ID=
#DHP_WEB_LOGIN_CLIENT_SECRET=
