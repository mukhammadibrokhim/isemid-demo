# Local-machine environment, loaded automatically on startup via
# springboot4-dotenv (see pom.xml). Copy this file to .env and edit as
# needed - .env itself is gitignored and must never be committed.
#
# Pairs with application-local.properties - gitignored personal overrides
# (create your own; it is NOT committed, unlike this template - see the
# "local profile" section in README.md).
#
# SPRING_PROFILES_ACTIVE=dev,local activates BOTH profiles: dev supplies the
# shared SSO/DHP/API2/LIS test-environment defaults (see .env.example for
# the full SSO_*/DHP_*/API2_*/LIS_* variable list if you need to override
# any of those), local overrides just the DB/port/logging/CORS below for
# your machine - Spring merges profile property files in listed order, so
# local's values win over dev's for anything both define.

SPRING_PROFILES_ACTIVE=dev,local

# =========================
# Server
# =========================
SERVER_PORT=8081

# =========================
# Database - no container needed, just an empty "isemid_local" database on
# whatever PostgreSQL is already running on your machine (see the comment
# in application-local.properties). Adjust the port/credentials below to
# match your actual local instance.
# =========================
DB_URL=jdbc:postgresql://localhost:5432/isemid_local
DB_USERNAME=postgres
DB_PASSWORD=postgres

# =========================
# CORS - local frontend dev servers
# =========================
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
